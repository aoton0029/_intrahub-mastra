LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=

# MediaVault MCP（Read Onlyツールのみ使用する）
MEDIAVAULT_MCP_URL=http://mediavault-mcp:8081
MEDIAVAULT_MCP_TOKEN=

# ナレッジ領域（コンテナ内の絶対パス）
KNOWLEDGE_ROOT=/workspace
AI_WORKSPACE_DIR=/workspace/ai-workspace
SECOND_BRAIN_DIR=/workspace/second-brain

# Agentごとの論理モデル名。LiteLLMのmodel_listに存在する名前だけを指定する。
# 既定値はコード側に持つため、上書きする場合のみ設定する。
# MODEL_MEDIA_RESEARCH=vllm
# MODEL_KNOWLEDGE_WRITER=anthropic
# MODEL_VAULT_CURATOR=vllm
